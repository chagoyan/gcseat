# ── Aeries connection — the ONLY place the certificate lives ─────────────────
# Local dev (default): point at mock-aeries-server.
AERIES_BASE_URL=http://localhost:4000
AERIES_CERT=MOCK-CERT-LOCAL-DEV-ONLY
AERIES_SCHOOL_CODE=1

# mock | real — see README.md "Swapping to the real Aeries API" before
# flipping this. Swapping the URL/cert alone is NOT enough; the name-based
# lookup step only exists against the mock server.
AERIES_MODE=mock

# ── Server ────────────────────────────────────────────────────────────────
PORT=3001

# Only this origin may call this backend from a browser.
ALLOWED_ORIGIN=http://localhost:8081
